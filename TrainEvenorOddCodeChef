import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
	  Scanner in= new Scanner(System.in);
	  int t=in.nextInt();
	 while(t-->0){
	      int n=in.nextInt();
	      int a[]=new int[n];
	      int evenSum=0;
	      int oddSum=0;
	      for(int i=0;i<n;i++){
	          a[i]=in.nextInt();
	      }
	      for(int i=0;i<n;i++){
	          if((i+1)%2 == 0){
	              evenSum+= a[i];
	          }
	          else{
	              oddSum+= a[i];
	          }
	      }
	      if(evenSum>oddSum){
	          System.out.println(evenSum);
	      }
	      else{
	          System.out.println(oddSum);
	      }
	  }// your code goes here

	}
}
